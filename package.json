{
  "name": "sistemaia",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de administración para revisión de entregas de SolidWorks con rúbricas y retroalimentación",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "seed": "node supabase/seed.js"
  },
  "engines": {
    "node": ">=18"
  }
}
