# ===== Backend (apps/api) =====
# URL y llave de tu proyecto Supabase (Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_ANON_KEY=tu-anon-key

# Secreto para firmar los JWT de sesión (genera uno largo y aleatorio)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Puerto del servidor local
PORT=3001

# ===== Balance de cargas (cluster) =====
# 1 = un solo proceso. >1 crea N workers con balanceo least-connections.
CLUSTER_WORKERS=1

# ===== Frontend (apps/web) =====
# URL base del API en desarrollo local
VITE_API_URL=http://localhost:3001
# En producción Vercel: https://tu-api.vercel.app  (o mismo dominio con rewrites)
# Supabase Auth — estas van en apps/web/.env (Vite solo lee .env de su propio paquete)
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_ANON_KEY=tu-anon-key
